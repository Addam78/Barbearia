# Usado pelos testes e2e (pnpm test:e2e). Copie para .env.test.

# Banco de teste (barbearia_test), separado do banco de desenvolvimento.
# Usuário, senha e porta devem bater com o POSTGRES_* do seu .env.
DATABASE_URL="postgresql://barbearia:barbearia01@127.0.0.1:5433/barbearia_test?schema=public"

JWT_SECRET="troque-por-um-segredo-aleatorio-de-teste"

# Obrigatória: sem ela a aplicação não sobe nos e2e.
# Deve bater com RABBITMQ_USER, RABBITMQ_PASSWORD e RABBITMQ_PORT do seu .env.
AMQP_URL="amqp://exemplo:exemplo@localhost:5690"
