# Copie para .env e ajuste os valores. O .env nunca deve ser versionado.

# --- Postgres (usado pelo docker-compose) ---
POSTGRES_USER=barbearia
POSTGRES_PASSWORD=barbearia01
POSTGRES_DB=barbearia
POSTGRES_TEST_DB=barbearia_test
POSTGRES_PORT=5433

# Conexão da aplicação com o Postgres. Deve repetir usuário, senha, porta e banco acima.
DATABASE_URL="postgresql://barbearia:barbearia01@127.0.0.1:5433/barbearia?schema=public"

# --- RabbitMQ (usado pelo docker-compose) ---
RABBITMQ_USER=exemplo
RABBITMQ_PASSWORD=exemplo
RABBITMQ_PORT=5690
# Painel de administração do RabbitMQ (http://localhost:<porta>). Porta válida: de 1 a 65535.
RABBITMQ_MANAGEMENT_PORT=15672

# Conexão da aplicação com o RabbitMQ. Deve repetir usuário, senha e porta acima.
# Evite os caracteres @ : / # na senha; se precisar deles, codifique (ex: @ vira %40).
AMQP_URL="amqp://exemplo:exemplo@localhost:5690"

# --- Aplicação ---
# Gere um segredo novo: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET="troque-por-um-segredo-aleatorio"

# Porta da API (opcional, o padrão é 3000). Mude se a 3000 já estiver ocupada na sua máquina.
PORT=3000

# Origem do frontend, liberada no CORS.
FRONTEND_URL=http://localhost:5173

# --- E-mail (convite de barbeiro) ---
# Em desenvolvimento use uma caixa de testes (ex: Mailtrap) em vez de um e-mail real.
# O SMTP_USER também é usado como remetente (from) dos e-mails.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=seu-usuario-smtp
SMTP_PASS=sua-senha-smtp
